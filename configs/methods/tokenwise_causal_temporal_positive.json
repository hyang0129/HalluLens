{
  "name": "tokenwise_causal_temporal_positive",
  "routine": "tokenwise_contrastive_logprob_recon",
  "model_class": "logprob_recon_progressive_compressor",
  "model_params": {
    "final_dim": 512,
    "input_dropout": 0.3,
    "recon_seq_len": 64,
    "recon_hidden_dim": 256,
    "recon_lambda": 1.0,
    "logprob_var_threshold": 0.0001
  },
  "training": {
    "max_epochs": 100,
    "batch_size": 512,
    "lr": 0.00001,
    "temperature": 0.25,
    "sub_batch_size": 64,
    "use_labels": true,
    "ignore_label": 1,
    "contrastive_objective": "tokenwise_causal_control",
    "temporal_loss_weight": 1.0,
    "class_loss_weight": 1.0,
    "use_infinite_index_stream": true,
    "balanced_sampling": false,
    "grad_clip_norm": 1.0,
    "min_total_steps": 3000,
    "select_on_val": true,
    "checkpoint_selection_metric": "knn_auroc",
    "validation_knn": {
      "k": 50,
      "metric": "euclidean",
      "calibrate_k": false,
      "train_selection": "all",
      "max_train_size": 200000
    }
  },
  "data": {
    "view_adapter": "tokenwise_shared_contrastive_cache",
    "relevant_layers": "1-32",
    "num_views": 2,
    "token_pair_mode": "first_anchored",
    "shuffle_length_bucket_size": 8,
    "emit_view_logprob_targets": true,
    "pad_length": 64,
    "preload": true,
    "include_response_logprobs": true,
    "response_logprobs_top_k": 20
  },
  "evaluation": {
    "metrics": ["mds", "knn", "linear_probe"],
    "knn_params": {
      "k": 50,
      "metric": "euclidean",
      "calibrate_k": true,
      "k_candidates": [50, 100, 200, 500, 1000],
      "max_train_size": 200000
    },
    "cosine_knn_params": {
      "k": 50,
      "metric": "cosine",
      "l2_normalize": true,
      "calibrate_k": true,
      "k_candidates": [50, 100, 200, 500, 1000],
      "max_train_size": 200000
    },
    "linear_probe_params": {
      "C": 1.0,
      "max_iter": 1000,
      "class_weight": null,
      "max_train_size": 200000
    },
    "eval_batch_size": 256,
    "sub_batch_size": 64,
    "dump_embeddings": true,
    "eval_token_curve": false
  }
}
