{
  "name": "tokenwise_contrastive_random_distinct",
  "routine": "tokenwise_contrastive_logprob_recon",
  "model_class": "logprob_recon_progressive_compressor",
  "model_params": {
    "final_dim": 512,
    "input_dropout": 0.3,
    "recon_seq_len": 64,
    "recon_hidden_dim": 256,
    "recon_lambda": 1.0,
    "logprob_var_threshold": 0.0001
  },
  "training": {
    "max_epochs": 100,
    "batch_size": 512,
    "lr": 1e-05,
    "temperature": 0.25,
    "sub_batch_size": 64,
    "use_labels": true,
    "ignore_label": 1,
    "use_infinite_index_stream": true,
    "balanced_sampling": false,
    "grad_clip_norm": 1.0,
    "min_total_steps": 3000
  },
  "data": {
    "relevant_layers": "1-32",
    "num_views": 2,
    "token_pair_mode": "random_distinct",
    "pad_length": 64,
    "preload": true,
    "include_response_logprobs": true,
    "response_logprobs_top_k": 20
  },
  "evaluation": {
    "metrics": [
      "cosine",
      "mds",
      "knn"
    ],
    "knn_params": {
      "k": 50,
      "metric": "euclidean",
      "calibrate_k": true,
      "k_candidates": [
        50,
        100,
        200,
        500,
        1000
      ],
      "max_train_size": 200000
    },
    "eval_batch_size": 256,
    "sub_batch_size": 64,
    "dump_embeddings": true,
    "eval_token_curve": true,
    "eval_token_positions": [
      0,
      1,
      3,
      7,
      15,
      31,
      63
    ]
  }
}
