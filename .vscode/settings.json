{
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "python.languageServer": "Pylance",
    "python.analysis.exclude": [
        "**/output/**",
        "**/results/**",
        "**/runs/**",
        "**/runs_archive/**",
        "**/shared/**"
    ],
    "files.watcherExclude": {
        "**/output/**": true,
        "**/results/**": true,
        "**/runs/**": true,
        "**/runs_archive/**": true,
        "**/shared/**": true,
        "**/.git/objects/**": true
    }
}
